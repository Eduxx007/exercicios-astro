---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import GradualBlur from '../components/GradualBlur.astro';
const { page = 'inicio' } = Astro.props;
---
<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  
  <title></title>
  <meta name="robots" content="noindex, nofollow" />
  <!-- Pré-carregamentos feitos antes de qualquer análise de prioridade -->
  <link rel="preload" as="image" href="/images/torra-clara.webp" />
  <link rel="preload" as="image" href="/images/torra-media.webp" />
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
  <ClientRouter />
</head>
<body>
<header class="site-header" transition:persist>
 <div class="container nav-wrapper">
  <a class="brand" href="/" aria-label="Início NORD"><span class="brand-mark">N</span><span>NORD</span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-label="Abrir menu de navegação" aria-controls="main-menu">
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav id="main-menu" class="main-nav" aria-label="Navegação principal" transition:persist>
   <a href="/">Início</a><a href="/torras/">Torras</a><a href="/#origem">Experiência</a><a class="nav-cta" href="/torras/">Quero conhecer</a>
  </nav>
 </div>
</header>
<div class="page-content" transition:animate="fade"><slot /></div>
<footer class="site-footer" transition:persist><div class="container footer-grid">
 <div><a class="brand brand-footer" href="/"><span class="brand-mark">N</span><span>NORD</span></a><p>Café especial para experiências simples e bem cuidadas.</p></div>
 <ul class="footer-links"><a href="/">Início</a><a href="/torras/">Torras</a><a href="/#origem">Experiência</a><a class="icon-link" href="/torras/"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"/></svg></a></ul>
 <p class="copyright">© <span id="current-year">2026</span> NORD Café Especial.</p>
</div></footer>
<script is:inline src="/js/main.js"></script>
<GradualBlur
  position="top"
  target="page"
  height="5.5rem"
  strength={2}
  layers={8}
  curve="linear"
  exponential={true}
  tint="rgba(246, 240, 230, 0.6)"
  autoHide={true}
  zIndex={45}
  transition:persist
/>
<GradualBlur
  position="bottom"
  target="page"
  height="6rem"
  strength={2}
  layers={8}
  curve="linear"
  exponential={true}
  tint="rgba(246, 240, 230, 0.6)"
  autoHide={true}
  zIndex={40}
  transition:persist
/>
</body></html>
