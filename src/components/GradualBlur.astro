---
interface Props {
  position?: 'top' | 'bottom' | 'left' | 'right';
  target?: 'parent' | 'page';
  height?: string | number;
  width?: string | number;
  strength?: number;
  layers?: number;
  curve?: 'linear' | 'bezier' | 'ease-in' | 'ease-out' | 'ease-in-out';
  exponential?: boolean;
  opacity?: number;
  saturation?: number;
  tint?: string;
  autoHide?: boolean;
  container?: string;
  hoverIntensity?: number;
  duration?: number | string;
  easing?: string;
  zIndex?: number;
  className?: string;
  style?: string | Record<string, string | number>;
  id?: string;
  [key: string]: any;
}

const CURVES: Record<string, (t: number) => number> = {
  linear: (t: number) => t,
  bezier: (t: number) => t * t * (3 - 2 * t),
  'ease-in': (t: number) => t * t,
  'ease-out': (t: number) => 1 - (1 - t) * (1 - t),
  'ease-in-out': (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2)
};

const DIRECTIONS: Record<string, string> = {
  top: 'to top',
  bottom: 'to bottom',
  left: 'to left',
  right: 'to right'
};

const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);
const toLength = (v?: string | number) => (typeof v === 'number' ? `${v}px` : v);
const toTime = (v?: string | number) => (typeof v === 'number' ? `${v}s` : v);

const {
  position = 'bottom',
  target = 'parent',
  height = '6rem',
  width,
  strength = 2,
  layers = 8,
  curve = 'linear',
  exponential = true,
  opacity = 1,
  saturation = 1,
  tint = 'transparent',
  autoHide = false,
  container = '',
  hoverIntensity = 1,
  duration = 0.3,
  easing = 'ease-out',
  zIndex = 1000,
  className = '',
  style = '',
  id,
  ...rest
} = Astro.props;

const edge = DIRECTIONS[position] ? position : 'bottom';
const vertical = edge === 'top' || edge === 'bottom';
const count = Math.min(Math.max(Math.round(layers) || 1, 1), 16);
const shape = CURVES[curve] || CURVES.linear;
const maxBlur = Math.max(strength, 0) * 12;

const level = (u: number) => {
  const t = shape(clamp01(u));
  return maxBlur * (exponential ? (Math.pow(2, 4 * t) - 1) / 15 : t);
};

const boost = Math.pow(Math.max(saturation, 0), 1 / count);
const fade = `${toTime(duration)} ${easing}`;
const direction = DIRECTIONS[edge];

const steps: Array<{ style: string }> = [];
for (let i = 0; i < count; i++) {
  const from = level(i / count);
  const to = level((i + 1) / count);
  const radius = Math.sqrt(Math.max(to * to - from * from, 0));
  const filter = [
    `blur(calc(${radius.toFixed(3)}px * var(--gradual-blur-reveal, 1) * var(--gradual-blur-hover, 1)))`,
    boost !== 1 ? `saturate(calc(1 + ${(boost - 1).toFixed(4)} * var(--gradual-blur-reveal, 1)))` : ''
  ]
    .filter(Boolean)
    .join(' ');
  const mask = `linear-gradient(${direction}, transparent ${((i / count) * 100).toFixed(2)}%, #000 ${(((i + 1) / count) * 100).toFixed(2)}%)`;

  const layerStyle = [
    'position: absolute',
    'inset: 0',
    'border-radius: inherit',
    `backdrop-filter: ${filter}`,
    `-webkit-backdrop-filter: ${filter}`,
    `mask-image: ${mask}`,
    `-webkit-mask-image: ${mask}`,
    `opacity: ${opacity}`,
    `transition: backdrop-filter ${fade}, -webkit-backdrop-filter ${fade}`,
    'pointer-events: none'
  ].join('; ');

  steps.push({ style: layerStyle });
}

let washStyle = '';
if (tint && tint !== 'transparent') {
  const stops = Array.from({ length: 9 }, (_, k) => {
    const u = k / 8;
    const t = shape(u);
    const alpha = t * t * t * (t * (t * 6 - 15) + 10);
    return `rgba(0, 0, 0, ${alpha.toFixed(3)}) ${(u * 100).toFixed(1)}%`;
  }).join(', ');
  const tintMask = `linear-gradient(${direction}, ${stops})`;

  washStyle = [
    'position: absolute',
    'inset: 0',
    'border-radius: inherit',
    `background: ${tint}`,
    `mask-image: ${tintMask}`,
    `-webkit-mask-image: ${tintMask}`,
    'opacity: calc(var(--gradual-blur-reveal, 1) * min(var(--gradual-blur-hover, 1), 1))',
    `transition: opacity ${fade}`,
    'pointer-events: none'
  ].join('; ');
}

const depth = toLength(vertical ? height : (width ?? height));
const span = vertical && width != null ? toLength(width) : null;
const rounded = target !== 'page' && !span;
const corner = (a: string, b: string) => (rounded && (edge === a || edge === b) ? 'inherit' : undefined);

const extraStyleStr = typeof style === 'object' && style !== null
  ? Object.entries(style).map(([k, v]) => `${k.replace(/([A-Z])/g, '-$1').toLowerCase()}: ${v}`).join('; ')
  : (style || '');

const initialRevealStyle = autoHide && (edge === 'top' || edge === 'left') ? '--gradual-blur-reveal: 0;' : '';

const rootStyles = [
  `position: ${target === 'page' ? 'fixed' : 'absolute'}`,
  `z-index: ${zIndex}`,
  corner('top', 'left') ? 'border-top-left-radius: inherit' : '',
  corner('top', 'right') ? 'border-top-right-radius: inherit' : '',
  corner('bottom', 'left') ? 'border-bottom-left-radius: inherit' : '',
  corner('bottom', 'right') ? 'border-bottom-right-radius: inherit' : '',
  edge !== 'bottom' ? 'top: 0' : '',
  edge !== 'top' ? 'bottom: 0' : '',
  edge !== 'right' ? 'left: 0' : '',
  edge !== 'left' ? 'right: 0' : '',
  vertical && depth ? `height: ${depth}` : '',
  !vertical && depth ? `width: ${depth}` : '',
  vertical && span ? `width: ${span}` : '',
  span ? 'margin-inline: auto' : '',
  'pointer-events: none',
  initialRevealStyle,
  extraStyleStr
].filter(Boolean).join('; ');
---

<div
  id={id}
  class={`gradual-blur ${className}`.trim()}
  style={rootStyles}
  data-gradual-blur
  data-target={target}
  data-position={edge}
  data-auto-hide={autoHide ? 'true' : 'false'}
  data-container={container}
  data-hover-intensity={hoverIntensity}
  aria-hidden="true"
  {...rest}
>
  {steps.map((layer) => (
    <div style={layer.style} />
  ))}
  {washStyle && <div style={washStyle} />}
</div>

<style>
  .gradual-blur {
    pointer-events: none;
  }
</style>

<script>
  function setupGradualBlurs() {
    const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);

    const findScroller = (container: string | null, root: HTMLElement, target: string, vertical: boolean) => {
      if (container) {
        return document.querySelector(container);
      }
      if (target === 'page') return window;
      const parent = root.parentElement;
      if (!parent) return null;
      const scrolls = (node: HTMLElement) => {
        const style = getComputedStyle(node);
        return /(auto|scroll|overlay)/.test(vertical ? style.overflowY : style.overflowX);
      };
      const sibling = Array.from(parent.children).find((child) => child !== root && scrolls(child as HTMLElement));
      return sibling || (scrolls(parent) ? parent : null);
    };

    const elements = document.querySelectorAll<HTMLElement>('[data-gradual-blur]');

    elements.forEach((root) => {
      if (root.dataset.blurInitialized === 'true') return;
      root.dataset.blurInitialized = 'true';

      const target = root.dataset.target || 'parent';
      const edge = root.dataset.position || 'bottom';
      const vertical = edge === 'top' || edge === 'bottom';
      const autoHide = root.dataset.autoHide === 'true';
      const containerSelector = root.dataset.container || null;
      const hoverIntensity = parseFloat(root.dataset.hoverIntensity || '1');

      if (autoHide) {
        const scroller = findScroller(containerSelector, root, target, vertical);
        if (scroller) {
          const element = scroller instanceof Element ? (scroller as HTMLElement) : null;
          const start = edge === 'top' || edge === 'left';

          const update = () => {
            const page = document.documentElement;
            const offset = element
              ? vertical
                ? element.scrollTop
                : element.scrollLeft
              : vertical
                ? window.scrollY
                : window.scrollX;
            const limit = element
              ? vertical
                ? element.scrollHeight - element.clientHeight
                : element.scrollWidth - element.clientWidth
              : vertical
                ? page.scrollHeight - window.innerHeight
                : page.scrollWidth - window.innerWidth;
            const box = root.getBoundingClientRect();
            const reach = Math.max(vertical ? box.height : box.width, 1);
            const room = start ? offset : limit - offset;
            root.style.setProperty('--gradual-blur-reveal', clamp01(room / reach).toFixed(3));
          };

          update();
          const source = element ?? window;
          source.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);

          if (element && typeof ResizeObserver !== 'undefined') {
            const observer = new ResizeObserver(update);
            observer.observe(element);
            if (element.firstElementChild) observer.observe(element.firstElementChild);
          }
        }
      }

      if (hoverIntensity !== 1) {
        let frame = 0;
        let inside = false;
        let point: { x: number; y: number } | null = null;

        const check = () => {
          frame = 0;
          if (!point) return;
          const box = root.getBoundingClientRect();
          const now = point.x >= box.left && point.x <= box.right && point.y >= box.top && point.y <= box.bottom;
          if (now === inside) return;
          inside = now;
          root.style.setProperty('--gradual-blur-hover', inside ? String(Math.max(hoverIntensity, 0)) : '1');
        };

        const onMove = (event: PointerEvent) => {
          point = { x: event.clientX, y: event.clientY };
          if (!frame) frame = requestAnimationFrame(check);
        };

        const onLeave = () => {
          point = null;
          inside = false;
          root.style.setProperty('--gradual-blur-hover', '1');
        };

        window.addEventListener('pointermove', onMove, { passive: true });
        document.documentElement.addEventListener('pointerleave', onLeave);
      }
    });
  }

  setupGradualBlurs();
  document.addEventListener('astro:page-load', setupGradualBlurs);
</script>
